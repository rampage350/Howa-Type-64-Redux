<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Howa_Type64</AssemblyName>
    <RootNamespace>HowaType64</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match your server: SPT 4.1.x -->
    <PackageReference Include="SPTarkov.Common" Version="4.1.*" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.*" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.*" />
  </ItemGroup>

  <!-- Build output: dist/Howa_Type64 -> copy this folder to SPT/user/mods/ -->
  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <Dist>$(MSBuildProjectDirectory)\dist\Howa_Type64</Dist>
    </PropertyGroup>
    <ItemGroup>
      <ModData Include="$(MSBuildProjectDirectory)\Data\**\*" />
      <ModBundles Include="$(MSBuildProjectDirectory)\bundles\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(Dist)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\bundles.json" DestinationFolder="$(Dist)" Condition="Exists('$(MSBuildProjectDirectory)\bundles.json')" />
    <Copy SourceFiles="@(ModData)" DestinationFiles="@(ModData->'$(Dist)\Data\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModBundles)" DestinationFiles="@(ModBundles->'$(Dist)\bundles\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
